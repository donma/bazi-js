{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/evidence.schema.json",
  "title": "BaziJS Evidence Record",
  "type": "object",
  "required": ["evidenceId", "ruleIds"],
  "properties": {
    "evidenceId": {"type": "string"},
    "sourceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "sourceId": {"type": "string"},
    "ruleIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "citation": {"type": "string"},
    "originalBasis": {"type": "string"},
    "originalExcerpt": {"type": "string"},
    "transcription": {"type": "string"},
    "scope": {"type": "string"},
    "locator": {"type": "object"},
    "variants": {"type": "array"},
    "researchNotes": {"type": "string"}
  }
}
