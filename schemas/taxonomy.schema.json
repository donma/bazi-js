{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/taxonomy.schema.json",
  "title": "BaziJS Reference Taxonomy",
  "type": "object",
  "required": ["schemaVersion", "taxonomyId", "version", "conceptTypes", "patternTypes", "statuses"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "taxonomyId": {"type": "string"},
    "version": {"type": "string"},
    "conceptTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "patternTypes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "statuses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "legacyMappings": {"type": "object"}
  }
}
