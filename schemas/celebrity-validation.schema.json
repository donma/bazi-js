{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/celebrity-validation.schema.json",
  "title": "BaziJS Public Figure Validation Dataset",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "capturedAt", "purpose", "sources", "cases"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "datasetId": {"type": "string"},
    "capturedAt": {"type": "string"},
    "purpose": {"type": "string"},
    "sourcePolicy": {"type": "object"},
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/source"}
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["sourceId", "name", "url", "sourceType", "scope", "independence", "authorityLevel"],
      "properties": {
        "sourceId": {"type": "string"},
        "name": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"},
        "sourceType": {"type": "string"},
        "scope": {"type": "array", "items": {"type": "string"}},
        "independence": {"enum": ["external", "internal", "manual"]},
        "authorityLevel": {"enum": ["primary-record", "academic", "official", "secondary"]},
        "notes": {"type": "string"}
      }
    },
    "case": {
      "type": "object",
      "required": ["caseId", "person", "input", "discoverySources", "factSources", "externalObservation", "comparisonFields", "adjudication"],
      "properties": {
        "caseId": {"type": "string"},
        "person": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string"},
            "aliases": {"type": "array", "items": {"type": "string"}}
          }
        },
        "input": {
          "type": "object",
          "required": ["birthDate", "gender"],
          "properties": {
            "birthDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
            "birthTime": {"type": "string"},
            "birthTimeMode": {"enum": ["exact", "branch", "unknown"]},
            "birthHourBranch": {"type": "string"},
            "gender": {"enum": ["male", "female"]},
            "timezone": {"type": "string"},
            "trueSolarTime": {"type": "boolean"},
            "dayBoundary": {"enum": ["23:00", "00:00"]},
            "location": {"type": "object"}
          }
        },
        "discoverySources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "factSources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "externalObservation": {
          "type": "object",
          "required": ["sourceId", "classification", "sourceUrl", "scope", "observed", "notes"],
          "properties": {
            "sourceId": {"type": "string"},
            "classification": {"enum": ["match", "difference", "undetermined"]},
            "sourceUrl": {"type": "string", "pattern": "^https://"},
            "scope": {"type": "array", "items": {"type": "string"}},
            "observed": {"type": ["object", "null"]},
            "timeEvidence": {"type": "string"},
            "notes": {"type": "string"}
          }
        },
        "comparisonFields": {"type": "array", "minItems": 1, "items": {"enum": ["year", "month", "day", "hour"]}},
        "adjudication": {
          "type": "object",
          "required": ["classification", "canonicalChangeRequired", "reason"],
          "properties": {
            "classification": {"enum": ["match", "difference", "undetermined"]},
            "canonicalChangeRequired": {"type": "boolean"},
            "reason": {"type": "string"}
          }
        }
      }
    }
  }
}
