{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/profile-differential.schema.json",
  "title": "BaziJS Profile Differential Dataset",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "baseProfileId", "description", "cases"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "datasetId": {"type": "string"},
    "baseProfileId": {"type": "string"},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "purpose", "input", "profiles", "differsOn"],
        "properties": {
          "caseId": {"type": "string"},
          "purpose": {"type": "string"},
          "input": {"type": "object", "required": ["birthDate", "birthTime", "gender"]},
          "profiles": {"type": "object"},
          "differsOn": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    }
  }
}
