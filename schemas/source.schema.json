{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/source.schema.json",
  "title": "BaziJS Reference Source",
  "type": "object",
  "required": ["sourceId", "title", "sourceStatus", "locators", "references"],
  "properties": {
    "sourceId": {"type": "string"},
    "title": {"type": "string"},
    "author": {"type": "string"},
    "period": {"type": "string"},
    "sourceStatus": {"type": "string"},
    "editionNote": {"type": "string"},
    "locators": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "references": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "editionRecords": {"type": "array", "items": {"type": "object"}},
    "citations": {"type": "array", "items": {"type": "object"}}
  }
}
