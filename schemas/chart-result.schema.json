{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/chart-result.schema.json",
  "title": "BaziJS Chart Result",
  "type": "object",
  "required": ["meta", "input", "accuracy", "calendar", "pillars", "shenSha", "specialRules", "classicalSummary", "analysis", "rules"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["engineVersion", "ruleSetVersion", "profileId", "resultSchemaVersion"],
      "properties": {
        "apiVersion": {"type": "string"},
        "governanceVersion": {"type": "string"},
        "validationManifestVersion": {"type": "string"},
        "profile": {"type": "object"}
      }
    },
    "input": {"type": "object"},
    "accuracy": {
      "type": "object",
      "required": ["timeKnown", "hourPillarAvailable", "boundaryRules", "assumptions", "precision"],
      "properties": {
        "precision": {"type": "object"},
        "limitations": {"type": "array"}
      }
    },
    "calendar": {"type": "object", "required": ["solar", "lunar", "solarTerms", "time"]},
    "pillars": {
      "type": "object",
      "required": ["year", "month", "day", "hour"],
      "properties": {
        "year": {"$ref": "#/$defs/pillar"},
        "month": {"$ref": "#/$defs/pillar"},
        "day": {"$ref": "#/$defs/pillar"},
        "hour": {"$ref": "#/$defs/pillar"}
      }
    },
    "shenSha": {"type": "array"},
    "specialRules": {"type": "array"},
    "auxiliary": {
      "type": "object",
      "properties": {
        "mingGua": {"type": ["object", "null"]}
      }
    },
    "strength": {
      "type": "object",
      "properties": {
        "fiveCategory": {"type": ["object", "null"]}
      }
    },
    "classicalSummary": {"$ref": "#/$defs/classicalSummary"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "luckCycles": {"type": ["object", "null"]},
    "transits": {"type": ["object", "null"]},
    "rules": {"type": "object", "required": ["applied"]}
  },
  "$defs": {
    "pillar": {"type": "object", "required": ["ganzhi", "stem", "branch"]},
    "reference": {
      "type": "object",
      "required": ["sourceId", "title", "locator", "url"],
      "properties": {
        "sourceId": {"type": "string"},
        "title": {"type": "string"},
        "locator": {"type": "string"},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "classicalSummary": {
      "type": "object",
      "required": ["modelId", "version", "confidence", "tradition", "ruleId", "sections", "fiveCategory", "monthCommand", "voids", "auxiliary", "references", "variants", "researchNotes", "evidence"],
      "properties": {
        "modelId": {"type": "string"},
        "version": {"type": "string"},
        "confidence": {"type": "string"},
        "tradition": {"type": "string"},
        "conceptType": {"type": "string"},
        "ruleFamily": {"type": "string"},
        "baseOn": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "scope": {"type": "string"},
        "category": {"type": "string"},
        "ruleId": {"type": "string"},
        "method": {"type": "string"},
        "sections": {"type": "array", "items": {"type": "string"}, "minItems": 4},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}, "minItems": 1},
        "variants": {"type": "array"},
        "researchNotes": {"type": "object"},
        "evidence": {"type": "object", "required": ["matched", "chartPillars", "sectionEvidence"]},
        "fiveCategory": {"type": ["object", "null"]},
        "monthCommand": {"type": "object", "required": ["hiddenStems", "monthPillar", "evidence"]},
        "voids": {"type": "object", "required": ["byDay", "byYear", "rows", "evidence"]},
        "auxiliary": {"type": "object", "required": ["palaceRows", "matrix", "elementDistribution", "seasonalStates", "evidence"]}
      }
    },
    "analysis": {
      "type": "object",
      "required": ["schemaVersion", "profileId", "selected", "models", "ruleId", "version", "evidence"],
      "properties": {
        "schemaVersion": {"type": "string"},
        "profileId": {"type": "string"},
        "profileName": {"type": "string"},
        "selected": {"type": "object"},
        "models": {"type": "object"},
        "ruleId": {"type": "string"},
        "version": {"type": "string"},
        "evidence": {"type": "object", "required": ["matched", "profileId", "selectedModelIds", "nonCanonicalModels"]}
      }
    }
  }
}
