{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bazi-js.github.io/bazi-js/schemas/validation-manifest.schema.json",
  "title": "BaziJS Validation Manifest",
  "type": "object",
  "required": ["schemaVersion", "manifestId", "manifestVersion", "generatedAt", "datasets", "totals"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "manifestId": {"type": "string"},
    "manifestVersion": {"type": "string"},
    "generatedAt": {"type": "string"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["datasetId", "label", "capturedAt", "fixture", "report", "sourceIds", "scope", "cases", "classifications", "status"],
        "properties": {
          "datasetId": {"type": "string"},
          "label": {"type": "string"},
          "capturedAt": {"type": "string"},
          "fixture": {"type": "string"},
          "report": {"type": "string"},
          "sourceIds": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string"}},
          "cases": {"type": "integer", "minimum": 1},
          "canonicalChangeRequired": {"type": "integer", "minimum": 0},
          "status": {"type": "string"},
          "classifications": {"$ref": "#/$defs/classifications"}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["cases", "classifications", "sources"],
      "properties": {
        "cases": {"type": "integer", "minimum": 1},
        "sources": {"type": "integer", "minimum": 1},
        "classifications": {"$ref": "#/$defs/classifications"}
      }
    }
  },
  "$defs": {
    "classifications": {
      "type": "object",
      "required": ["match", "difference", "undetermined"],
      "properties": {
        "match": {"type": "integer", "minimum": 0},
        "difference": {"type": "integer", "minimum": 0},
        "undetermined": {"type": "integer", "minimum": 0}
      }
    }
  }
}
